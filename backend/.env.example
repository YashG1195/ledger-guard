# ──────────────────────────────────────────────
# LedgerGuard — environment variables
# Copy this file to .env and fill in every value.
# The app will CRASH on startup if any required variable is absent.
# ──────────────────────────────────────────────

# ── Server ─────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test

# ── MongoDB ────────────────────────────────────
# Multi-tenant: tenant DB names are appended at runtime (e.g. ledgerguard_<tenantId>)
MONGO_BASE_URI=mongodb://localhost:27017

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (RSA key paths, relative to project root) ──
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# ── Logging ────────────────────────────────────
LOG_LEVEL=info                # trace | debug | info | warn | error | fatal | silent

# ── CORS ───────────────────────────────────────
CORS_ORIGIN=*                 # Comma-separated origins or * (tighten in production)
